# TEMPLATE ONLY: not an installable default. Replace every /REPLACE/ path.
# Prerequisites: separately acquired compatible SDK/XRT/model, built worker,
# Python, device access, and a private existing RUN_PARENT directory.
# Validate the foreground launch and resource budgets before installing.
[Unit]
Description=AceIS optional private RyzenAI classifier
StartLimitIntervalSec=300
StartLimitBurst=2

[Service]
Type=simple
WorkingDirectory=/REPLACE/CHECKOUT
RuntimeDirectory=aceis-npu
RuntimeDirectoryMode=0700
UMask=0077
# Use a fresh per-invocation run directory. The parent directory must already exist.
ExecStart=/usr/bin/python3 -m inference.aceis_npu_service.service --worker /REPLACE/BUILT_WORKER --sdk /REPLACE/SDK_ROOT --xrt /REPLACE/XRT_ROOT --model /REPLACE/PINNED_MODEL.onnx --run-dir /REPLACE/RUN_PARENT/${INVOCATION_ID} --socket %t/aceis-npu/service.sock
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=8
[Install]
WantedBy=default.target
